{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Overlay over the game map: measuring and calibration.",
  "windows": [
    "overlay"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-overlay-exit",
    "allow-overlay-blank",
    "allow-save-calibration",
    "allow-submit-result",
    "allow-log-line"
  ]
}
