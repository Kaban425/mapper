{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: settings, status, wizard. Talks to Rust only through app commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-log-line",
    "allow-quit-app",
    "allow-get-snapshot",
    "allow-update-settings",
    "allow-set-hotkey",
    "allow-reset-hotkeys",
    "allow-suspend-hotkeys",
    "allow-arm-calibration",
    "allow-reset-calibration",
    "allow-set-autostart",
    "allow-check-update-now",
    "allow-open-link",
    "allow-open-folder",
    "allow-hide-main-window"
  ]
}
