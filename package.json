{
  "name": "mapper",
  "version": "0.1.0",
  "description": "Distance ruler overlay for the PUBG: BATTLEGROUNDS world map",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "guard": "node scripts/antiban-guard.mjs",
    "guard:exe": "node scripts/antiban-guard.mjs --exe auto",
    "tauri": "tauri",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.3",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
